{
  "name": "make-it-rain-on-them-grows",
  "version": "1.0.0",
  "description": "Make it Rain on Them Grows \u2014 a kawaii HD-2D restoration incremental",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:bundled": "cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true node scripts/build.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && rundot deploy --bump Patch",
    "deploy:minor": "npm run build && rundot deploy --bump Minor",
    "format": "prettier \"{src,public}/**/*.{ts,tsx,js,jsx,json,css,html}\" --write",
    "format:check": "prettier \"{src,public}/**/*.{ts,tsx,js,jsx,json,css,html}\" --check",
    "dump-upgrades": "npx tsx scripts/dump-upgrades.mjs",
    "assets:build": "npx -y @series-inc/stowkit-cli@0.6.42 build",
    "balance:sim": "python balance/sim.py",
    "balance:feel": "python balance/feel.py",
    "balance:diagnose": "python balance/diagnose.py",
    "balance:check": "python balance/check_balance.py",
    "balance:bloom": "python balance/bloom_feel.py",
    "build:fast": "node scripts/build.mjs --no-ts"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "three.js",
    "RUN.game"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "firebase": "^12.12.1",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.28.1",
    "@series-inc/stowkit-packer-gui": "^0.1.1",
    "@series-inc/stowkit-three-loader": "^0.1.43",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@series-inc/rundot-game-sdk"
    ]
  }
}
